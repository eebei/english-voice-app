{
  "name": "omoray-pitwall",
  "version": "0.1.0",
  "description": "OMORAY PITWALL — AI Race Engineer (desktop client)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "author": "OMORAY",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "racing.omoray.pitwall",
    "productName": "OMORAY PITWALL",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.html",
      "overlay.html",
      "build-info.json",
      "*.png"
    ],
    "extraResources": [
      {
        "from": "bridge/OMORAY-PITWALL-Bridge.exe",
        "to": "OMORAY-PITWALL-Bridge.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "app-icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OMORAY PITWALL",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "OMORAY-PITWALL-Setup-${version}.${ext}"
    }
  }
}
